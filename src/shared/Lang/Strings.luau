--!nocheck
-- Переводы. Порядок языков в каждой строке:
-- en, ru, es, pt, de, fr, tr, id, ja, ko, zh

local LANGS = { "en", "ru", "es", "pt", "de", "fr", "tr", "id", "ja", "ko", "zh" }
local S = {}

local function add(key, t)
	local row = {}
	for i, code in LANGS do
		row[code] = t[i]
	end
	S[key] = row
end

